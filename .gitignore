# Entorno
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Secretos
.env
.env.*

# Datos: solo se versionan los fixtures de prueba y la versión publicada en data/current
# (va dentro de la imagen Docker). data/demo y cualquier otra carpeta de datos quedan afuera.
data/*
!data/current/
*.parquet
!tests/fixtures/**/*.parquet
!data/current/**/*.parquet
!.env.example
